# LimeZu 授權素材與其衍生物（可用 tools/ 腳本 + Unity Tools 選單重生）
limezu/
unity/Assets/Sprites/LimeZu/
unity/Assets/Sprites/LimeZu.meta

# Unity 快取（開專案自動重生）
unity/Library/
unity/Temp/
unity/Logs/
unity/UserSettings/
unity/obj/
unity/*.csproj
unity/*.slnx
unity/*.sln

# 一般
.DS_Store
__pycache__/
.venv/
.env

# 根目錄 Unity 誤開殘骸防護（真專案在 unity/）
/Assets/
/Library/
/Logs/
/Packages/
/ProjectSettings/
/UserSettings/
/Temp/

# WebGL 等建置產物（Tools → Build WebGL 輸出，由橋伺服）
unity/Builds/

# Unity 崩潰恢復暫存
unity/Assets/_Recovery/
unity/Assets/_Recovery.meta

# 橋端工作紀錄落地（任務卡/黏性指派）
backend/office_state.json
backend/office_state.tmp
# 測試把 STATE_FILE 導到這個檔（test_office.py），每跑一次就重生
backend/office_state_test.json

# Playwright MCP 診斷產物（截圖/console log）
.playwright-mcp/

# 名冊頭像（LimeZu 衍生物，跑 tools/make_avatars.py 重生）
backend/avatars/

# 泡泡中文字型（16MB，OFL 授權；跑 tools/get_font.sh 取得）
unity/Assets/Resources/OfficeFont.otf
unity/Assets/Resources/OfficeFont.otf.meta

# 手動備份（web/index.html.bak 之類）——改壞了回得去，但不該進版控
*.bak
.demo-logs/

# 稽核帳本（append-only，部署資料，不進 git）
backend/audit/

# /brag 宣傳影片產物（含 LimeZu 素材截圖與衍生物，授權不可散布）
brag-output/

# 使用者的團隊設定（人設、班表）：精靈寫在這裡，不進 git——git pull 不衝突（docs/team-setup.md）
backend/team/
