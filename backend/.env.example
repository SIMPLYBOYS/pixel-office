# 複製成 .env 並填入你的 key
ANTHROPIC_API_KEY=sk-ant-xxxx

# 純投影模式：生活大腦（Claude 決策閒逛/搭話）停用，NPC 平時零成本 idle，
# 只有 cogito 的 /office/event 工作事件驅動行為。想跑生活模擬 demo 就註解掉這行。
OFFICE_MODE=projection

# Web 外殼派工：轉發到 cogito 的 HTTP 入口（cmd/claw 的 COGITO_HTTP_ADDR）。
# token 與 cogito .env 的 COGITO_HTTP_TOKEN 同值；token 只存在橋端，瀏覽器拿不到。
COGITO_HTTP=http://127.0.0.1:8787
COGITO_HTTP_TOKEN=換成隨機字串

# 工作 repo 綁定：掃此目錄下的 git 專案，派工可指定「在 repo X 上做」（worktree 掛進
# 員工工作區、成果 commit 在 office/... 分支）。不設＝外殼不畫 repo 欄位。
OFFICE_REPOS_DIR=~/Documents/OpenSourceProjects

# CLI 模式：用你已經在付的 Claude Code 訂閱跑任務，而不是按次計費的 API。
# 找得到指令才會在介面上出現這個選項。權限模式：-p 模式沒人能回答提問，所以要先講好
# （acceptEdits＝可改檔、高風險操作被拒而非卡住；bypassPermissions＝完全放手）。
OFFICE_CLI_CMD=claude
OFFICE_CLI_PERMISSION=acceptEdits
OFFICE_CLI_TIMEOUT=1800

# 員工 CLI 用的 Claude Code profile。【一定要跟你本人的 ~/.claude 分開】：你自己的 settings 若把
# Write/Edit 放在 permissions.ask，-p 模式沒有人能回答 ask ＝ 一律拒絕，員工永遠寫不出任何檔案
# （實測：acceptEdits 與 --allowedTools Write 都壓不過 ask 規則）。這個目錄只放 allow 與 deny、沒有 ask。
# 第一次要登入一次：CLAUDE_CONFIG_DIR=~/.claude-office claude → /login。
# 員工的 CLI session 也收在這底下（projects/），換 profile 等於員工從新的對話開始。
CLAUDE_CONFIG_DIR=~/.claude-office
