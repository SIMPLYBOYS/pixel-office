# 複製成 .env 並填入你的 key
ANTHROPIC_API_KEY=sk-ant-xxxx

# 純投影模式：生活大腦（Claude 決策閒逛/搭話）停用，NPC 平時零成本 idle，
# 只有 cogito 的 /office/event 工作事件驅動行為。想跑生活模擬 demo 就註解掉這行。
OFFICE_MODE=projection

# Web 外殼派工：轉發到 cogito 的 HTTP 入口（cmd/claw 的 COGITO_HTTP_ADDR）。
# token 與 cogito .env 的 COGITO_HTTP_TOKEN 同值；token 只存在橋端，瀏覽器拿不到。
COGITO_HTTP=http://127.0.0.1:8787
COGITO_HTTP_TOKEN=換成隨機字串
