# 複製成 .env 並填入你的 key
ANTHROPIC_API_KEY=sk-ant-xxxx

# 純投影模式：生活大腦（Claude 決策閒逛/搭話）停用，NPC 平時零成本 idle，
# 只有 cogito 的 /office/event 工作事件驅動行為。想跑生活模擬 demo 就註解掉這行。
OFFICE_MODE=projection

# Web 外殼派工：轉發到 cogito 的 HTTP 入口（cmd/claw 的 COGITO_HTTP_ADDR）。
# token 與 cogito .env 的 COGITO_HTTP_TOKEN 同值；token 只存在橋端，瀏覽器拿不到。
COGITO_HTTP=http://127.0.0.1:8787
COGITO_HTTP_TOKEN=換成隨機字串

# 工作 repo 綁定：掃此目錄下的 git 專案，派工可指定「在 repo X 上做」（worktree 掛進
# 員工工作區、成果 commit 在 office/... 分支）。不設＝外殼不畫 repo 欄位。
OFFICE_REPOS_DIR=~/Documents/OpenSourceProjects

# CLI 模式：用你已經在付的 Claude Code 訂閱跑任務，而不是按次計費的 API。
# 找得到指令才會在介面上出現這個選項。權限模式：-p 模式沒人能回答提問，所以要先講好
# （acceptEdits＝可改檔、高風險操作被拒而非卡住；bypassPermissions＝完全放手）。
OFFICE_CLI_CMD=claude
OFFICE_CLI_PERMISSION=acceptEdits
OFFICE_CLI_TIMEOUT=1800

# 員工的預設模型——三個引擎各自一份（型號互不相通），人設明寫 model 時以人設為準、外殼選過的以選的為準：
# - Claude Code：OFFICE_DEFAULT_MODEL（預設 claude-opus-5[1m]；設成空字串＝不帶 --model，交回 Claude Code 自己）。只收 Claude 型號。
# OFFICE_DEFAULT_MODEL=claude-opus-5[1m]
# - cogito：預設【不指定】，交給 cogito 自己的設定（COGITO_PROVIDER／OPENAI_MODEL／CLAUDE_MODEL）；要固定就設 OFFICE_COGITO_MODEL。
#   不共用 Claude 預設的理由：cogito 走 OpenAI 又沒有 Anthropic 金鑰時，claude 會被靜默忽略、畫面卻顯示 Opus。
# OFFICE_COGITO_MODEL=gpt-5.6-sol
# - Codex：見下面 OFFICE_CODEX_MODEL。
# 派子 agent 時由主 agent 依任務難度帶 haiku／sonnet 降級（見 personas/office.md）。

# ── Codex 引擎（OpenAI Codex CLI，ChatGPT 訂閱登入）──
# 找得到 codex 指令，外殼的「引擎」選單就多一個 Codex。員工子行程【不帶】OPENAI_API_KEY／CODEX_API_KEY（否則會改走 API 計費）。
# 不用設定就能用：選 Codex 引擎後按「登入 Codex」，用瀏覽器登入 ChatGPT（device code）。沙箱設成 danger-full-access 會停用（安全稽核 High #8）。
# OFFICE_CODEX_CMD=codex
# 員工用獨立的 CODEX_HOME，預設 ~/.codex-office（理由同 CLAUDE_CONFIG_DIR：你自己的信任清單、記憶、外掛不該混進員工；員工的對話也不會塞進你的 codex resume 清單）。
# 要換位置才設；不能設成 ~/.codex。登入在外殼按鈕完成，也可以自己在終端機跑 CODEX_HOME=<這個目錄> codex login。
# OFFICE_CODEX_HOME=~/.codex-office
# 沙箱：read-only｜workspace-write（預設，能寫工作區、沒有網路）；danger-full-access 一律拒絕
# OFFICE_CODEX_SANDBOX=workspace-write
# 跟 Claude Code 員工對齊（不用設定）：共通守則寫進這個 home 的 AGENTS.md（多一段工具對照，見 personas/codex.md）；
# 綁 repo 時人設用 developer_instructions 帶；MCP 照抄 CLAUDE_CONFIG_DIR/.claude.json 的 mcpServers；網頁走 Codex 內建搜尋；shell 可連網（抓 RSS／API 用 curl，內建搜尋開不了；尚無網域白名單，見安全稽核 #2）。
# 模型：沒設＝Codex 自己的預設；老闆派的活接續時會沿用那條 thread 當初的模型。
# OFFICE_CODEX_MODEL=gpt-6-astra

# 員工子行程（Claude Code／Codex 與它們啟動的 MCP）只拿到白名單環境變數：PATH、HOME、語系、終端、代理、憑證路徑、
# CLAUDE_CONFIG_DIR、CODEX_HOME。這份 .env 的 Telegram／Slack／cogito 金鑰都不會傳下去（安全稽核 High #3）。
# 真的要多給，逗號分隔逐一列名：
# OFFICE_AGENT_ENV_PASS=

# 員工 CLI 用的 Claude Code profile。【一定要跟你本人的 ~/.claude 分開】：你自己的 settings 若把
# Write/Edit 放在 permissions.ask，-p 模式沒有人能回答 ask ＝ 一律拒絕，員工永遠寫不出任何檔案
# （實測：acceptEdits 與 --allowedTools Write 都壓不過 ask 規則）。這個目錄只放 allow 與 deny、沒有 ask。
# 第一次要登入一次：CLAUDE_CONFIG_DIR=~/.claude-office claude → /login。
# 員工的 CLI session 也收在這底下（projects/），換 profile 等於員工從新的對話開始。
CLAUDE_CONFIG_DIR=~/.claude-office

# 班表交付：例行任務收工後把報表送到遠端，老闆不在辦公室也看得到。目標格式與 cogito 的
# COGITO_CRON_NOTIFY 同款：<平台>:<id>，逗號分隔可同時送兩邊（這欄填頻道／聊天室 id，不是 token）。
# 哪個檔由 schedule.json 的 job 決定："deliver": {"file": "trend-{date}.md", "to": [可選，覆蓋預設目標]}。
# 沒檔、檔沒更新、API 回錯，工作串都會明講；送到了才寫「已送到」。Slack 上傳檔案需要 files:write scope。
OFFICE_DELIVER_TO=telegram:123456789,slack:C0123ABC
TELEGRAM_BOT_TOKEN=與 cogito .env 同一把
SLACK_BOT_TOKEN=xoxb-與 cogito .env 同一把

# 人工介入、回溯、稽核（兩個引擎共用）
# CLI 員工的權限請求由 PermissionRequest hook 送到橋的 /office/permission（橋啟動時自動掛進 CLAUDE_CONFIG_DIR 的 settings.json），
# 開一張與 cogito 同款的審批卡等你決定；沒人按就逾時拒，班表任務（無人值守）立刻拒。
OFFICE_CLI_APPROVAL_S=300
# hook 找橋的位置（跑在 Claude Code 行程樹裡，繼承橋的環境）；橋不在 8123 時要改
OFFICE_URL=http://127.0.0.1:8123
# 稽核帳本：append-only、hash 鏈的 JSONL，記每個裁決（審批、政策拒絕、權限被擋、插話、中止、交付）。/office/audit 會驗整條鏈。
OFFICE_AUDIT_DIR=./audit
# cogito 的 session 目錄（回溯用，讀 history）；不設就由 COGITO_CHANNELS 往上一層推 .sessions
# OFFICE_COGITO_SESSIONS=<cogito>/workspace/.sessions
